---
import type { Role } from '../lib/game';

interface Props {
  role: Role;
  challengeId?: string;
  creatorName?: string;
  leaderboardCreatorOptIn?: boolean;
}

const { role, challengeId = '', creatorName = '', leaderboardCreatorOptIn = false } = Astro.props;
---
<section class="game-wrap" data-quiz data-role={role} data-challenge={challengeId} data-creator={creatorName} data-creator-hall-opt-in={String(leaderboardCreatorOptIn)}>
  <div class="progress-meta hidden" data-progress-meta>
    <span data-progress-label>Question 1 of 8</span><span>~60 sec</span>
  </div>
  <div class="progress hidden" data-progress><span></span></div>

  <div class="card name-screen" data-name-screen>
    <p class="eyebrow">{role === 'creator' ? 'Shubh aarambh • open the memory box' : `${creatorName} remembers your childhood differently`}</p>
    <h2>{role === 'creator' ? 'Ghar mein tumhe kya bulaate hain?' : 'Tumhari kahaani kya kehti hai?'}</h2>
    <p class="muted">Only a nickname. No phone number, email or signup.</p>
    <form data-name-form>
      <input data-name maxlength="24" autocomplete="nickname" placeholder={role === 'creator' ? 'Your nickname' : 'Your nickname'} required />
      {(role === 'creator' || leaderboardCreatorOptIn) && (
        <fieldset class="hall-choice" data-hall-choice>
          <legend>{role === 'creator' ? 'Put us in the Rakhi Hall of Fame?' : `Join ${creatorName} in the Hall of Fame?`}</legend>
          <p>Only nicknames, score and battle code become public. Answers stay private. Both siblings must say yes.</p>
          <div>
            <button type="button" class="hall-option hall-option-yes" data-hall-value="yes" aria-pressed="false">🏵️ Yes, add us</button>
            <button type="button" class="hall-option" data-hall-value="no" aria-pressed="false">🔒 Keep private</button>
          </div>
        </fieldset>
      )}
      <button class="btn btn-primary btn-block" type="submit">
        {role === 'creator' ? 'Apni Rakhi Battle shuru karo →' : 'Challenge accept karo →'}
      </button>
    </form>
  </div>

  <div class="card game-opening hidden" data-opening-screen aria-live="polite">
    <div class="opening-names"><strong data-opening-player></strong><span>×</span><strong>{role === 'sibling' ? creatorName : 'YOUR SIBLING'}</strong></div>
    <div class="animated-rakhi" aria-hidden="true"><i></i><span>र</span><i></i></div>
    <p class="eyebrow">Memory box opening…</p>
    <h2>Ek hi bachpan.<br /><span>Do alag kahaaniyan.</span></h2>
  </div>

  <div class="card question-screen hidden" data-question-screen aria-live="polite">
    <div class="question-emoji" data-emoji></div>
    <h2 class="question-title" data-question></h2>
    <div class="options" data-options></div>
  </div>

  <p class="status error" data-error aria-live="assertive"></p>
</section>

<script>
  import { questions, type Answers, type Role } from '../lib/game';
  import { rememberBattle } from '../lib/recent';

  const root = document.querySelector<HTMLElement>('[data-quiz]')!;
  {
    const role = root.dataset.role as Role;
    const challengeId = root.dataset.challenge || '';
    const nameScreen = root.querySelector<HTMLElement>('[data-name-screen]')!;
    const nameForm = root.querySelector<HTMLFormElement>('[data-name-form]')!;
    const nameInput = root.querySelector<HTMLInputElement>('[data-name]')!;
    const openingScreen = root.querySelector<HTMLElement>('[data-opening-screen]')!;
    const questionScreen = root.querySelector<HTMLElement>('[data-question-screen]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const progressMeta = root.querySelector<HTMLElement>('[data-progress-meta]')!;
    const progressBar = progress.querySelector<HTMLElement>('span')!;
    const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]')!;
    const emoji = root.querySelector<HTMLElement>('[data-emoji]')!;
    const title = root.querySelector<HTMLElement>('[data-question]')!;
    const options = root.querySelector<HTMLElement>('[data-options]')!;
    const error = root.querySelector<HTMLElement>('[data-error]')!;
    const answers: Answers = {};
    const draftKey = `rb_quiz_${role}_${challengeId || 'new'}`;
    let playerName = '';
    let leaderboardOptIn = false;
    let leaderboardChoiceMade = root.querySelectorAll('[data-hall-value]').length === 0;
    let index = 0;
    let busy = false;

    function saveDraft(nextIndex = index) {
      try {
        localStorage.setItem(draftKey, JSON.stringify({ name: playerName, answers, index: nextIndex, leaderboardOptIn }));
      } catch {
        // The game remains usable when storage is restricted.
      }
    }

    function clearDraft() {
      try { localStorage.removeItem(draftKey); } catch { /* Storage is optional. */ }
    }

    function saveSiblingProgress(progressValue: number) {
      if (role !== 'sibling' || !challengeId) return;
      void fetch(`/api/challenges/${challengeId}/progress`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ progress: progressValue }),
      }).catch(() => {});
    }

    function showQuestion() {
      const question = questions[index];
      progressBar.style.width = `${((index + 1) / questions.length) * 100}%`;
      progressLabel.textContent = `Question ${index + 1} of ${questions.length}`;
      emoji.textContent = question.emoji;
      title.textContent = question.prompt;
      options.replaceChildren();
      questionScreen.classList.remove('question-enter');
      void questionScreen.offsetWidth;
      questionScreen.classList.add('question-enter');
      question.options.forEach((option) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'option';
        button.textContent = option[role];
        button.addEventListener('click', () => {
          if (busy) return;
          busy = true;
          button.classList.add('selected');
          answers[question.key] = option.id;
          saveDraft(index + 1);
          saveSiblingProgress(index + 1);
          setTimeout(async () => {
            index += 1;
            if (index < questions.length) {
              busy = false;
              showQuestion();
            } else {
              await finish();
            }
          }, 280);
        });
        options.appendChild(button);
      });
    }

    function beginQuestions(withOpening: boolean) {
      nameScreen.classList.add('hidden');
      root.classList.add('quiz-active');
      const revealQuestions = () => {
        openingScreen.classList.add('hidden');
        questionScreen.classList.remove('hidden');
        progress.classList.remove('hidden');
        progressMeta.classList.remove('hidden');
        showQuestion();
        requestAnimationFrame(() => root.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      };
      if (!withOpening || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        revealQuestions();
        return;
      }
      openingScreen.querySelector<HTMLElement>('[data-opening-player]')!.textContent = playerName.toUpperCase();
      openingScreen.classList.remove('hidden');
      setTimeout(revealQuestions, 1600);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-hall-value]').forEach((button) => {
      button.addEventListener('click', () => {
        leaderboardChoiceMade = true;
        leaderboardOptIn = button.dataset.hallValue === 'yes';
        root.querySelectorAll<HTMLButtonElement>('[data-hall-value]').forEach((option) => {
          const selected = option === button;
          option.classList.toggle('selected', selected);
          option.setAttribute('aria-pressed', String(selected));
        });
        error.textContent = '';
      });
    });

    async function finish() {
      error.textContent = '';
      try {
        const attr = window.rakhiAttribution || { source: 'direct' };
        const endpoint = role === 'creator' ? '/api/challenges' : `/api/challenges/${challengeId}/complete`;
        const payload = role === 'creator'
          ? { creator_name: playerName, answers, leaderboard_opt_in: leaderboardOptIn, session_id: window.rakhiSession, ...attr }
          : { sibling_name: playerName, answers, leaderboard_opt_in: leaderboardOptIn, session_id: window.rakhiSession, ...attr };
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json() as { error?: string; id: string; result: { percent: number } };
        if (!response.ok) throw new Error(data.error || 'Something went wrong');
        clearDraft();
        if (role === 'creator') {
          rememberBattle({ id: data.id, name: playerName, role: 'creator' });
          if (window.rakhiAttribution?.parent_challenge_id) {
            window.rakhiAttribution.parent_challenge_id = null;
            localStorage.setItem('rb_attr', JSON.stringify(window.rakhiAttribution));
          }
          window.rakhiTrack('battle_creator_complete', {}, data.id);
          location.href = `/waiting/${data.id}?fresh=1`;
        } else {
          rememberBattle({ id: challengeId, name: `${root.dataset.creator} × ${playerName}`, role: 'sibling' });
          window.rakhiTrack('challenge_complete', { score: data.result.percent }, challengeId);
          location.href = `/result/${challengeId}?fresh=1`;
        }
      } catch (reason) {
        busy = false;
        index = Math.max(0, questions.length - 1);
        error.textContent = reason instanceof Error ? reason.message : 'Please retry.';
      }
    }

    nameForm.addEventListener('submit', (event) => {
      event.preventDefault();
      playerName = nameInput.value.trim().slice(0, 24);
      if (!playerName) return;
      if (!leaderboardChoiceMade) {
        error.textContent = 'Choose Hall of Fame or Keep private to continue.';
        root.querySelector<HTMLElement>('[data-hall-choice]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      saveDraft(0);
      if (role === 'sibling' && challengeId) {
        rememberBattle({ id: challengeId, name: `${root.dataset.creator} × ${playerName}`, role: 'sibling' });
      }
      window.rakhiTrack(role === 'creator' ? 'battle_start' : 'challenge_open', {}, challengeId || null);
      saveSiblingProgress(0);
      beginQuestions(true);
    });

    try {
      const draft = JSON.parse(localStorage.getItem(draftKey) || 'null') as {
        name?: string;
        answers?: Record<string, unknown>;
        index?: number;
        leaderboardOptIn?: boolean;
      } | null;
      if (draft?.name && typeof draft.name === 'string') {
        playerName = draft.name.slice(0, 24);
        nameInput.value = playerName;
        leaderboardOptIn = draft.leaderboardOptIn === true;
        leaderboardChoiceMade = true;
        for (const question of questions) {
          const value = draft.answers?.[question.key];
          if (['creator', 'sibling', 'both', 'denied'].includes(String(value))) answers[question.key] = value as Answers[string];
        }
        index = Math.max(0, Math.min(Number(draft.index || 0), questions.length));
        if (index >= questions.length) void finish();
        else beginQuestions(false);
      }
    } catch {
      clearDraft();
    }
  }
</script>
