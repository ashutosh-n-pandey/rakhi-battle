---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  gameMode?: boolean;
}

const {
  title = 'Rakhi Battle 2026 — Ek hi bachpan. Do alag kahaaniyan.',
  description = 'Open eight sibling memories, compare two childhood stories and discover your research-inspired Rakhi relationship type—free and without signup.',
  image = '/images/rakhi-share.webp',
  noindex = false,
  gameMode = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#7d1538" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'game-mode': gameMode }}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Rakhi Battle home">
        <span class="brand-mark" aria-hidden="true">र</span>
        <span>RAKHI BATTLE <b>2026</b></span>
      </a>
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/#how">How it works</a>
        <a href="/leaderboard">Hall of Fame</a>
        <span class="countdown">28 AUG</span>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>Rakhi Battle by <strong>BondBop</strong> • Operated in India by Divya Pandey • <a href="mailto:support@bondbop.com">support@bondbop.com</a></p>
      <p>Made with mithai, mischief and sibling pyaar. No accounts. No phone numbers.</p>
      <nav><a href="/pricing">Pricing</a><a href="/shipping">Shipping</a><a href="/delivery">Digital Delivery</a><a href="/refund">Cancellation & Refunds</a><a href="/contact">Support</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
    </footer>
    <script is:inline>
      (() => {
        const key = 'rb_session';
        const session = localStorage.getItem(key) || crypto.randomUUID();
        localStorage.setItem(key, session);
        const params = new URLSearchParams(location.search);
        const saved = JSON.parse(localStorage.getItem('rb_attr') || '{}');
        const attr = {
          source: params.get('ref') || params.get('utm_source') || saved.source || 'direct',
          utm_source: params.get('utm_source') || saved.utm_source || null,
          utm_medium: params.get('utm_medium') || saved.utm_medium || null,
          utm_campaign: params.get('utm_campaign') || saved.utm_campaign || null,
          parent_challenge_id: /^[a-f0-9]{24}$/.test(params.get('parent') || '')
            ? params.get('parent')
            : saved.parent_challenge_id || null,
        };
        localStorage.setItem('rb_attr', JSON.stringify(attr));
        window.rakhiSession = session;
        window.rakhiAttribution = attr;
        window.rakhiTrack = (event, payload = {}, challenge_id = null) => {
          const body = JSON.stringify({ event, session_id: session, challenge_id, ...attr, payload });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/events', new Blob([body], { type: 'application/json' }));
          else fetch('/api/events', { method: 'POST', headers: { 'content-type': 'application/json' }, body, keepalive: true }).catch(() => {});
        };

        document.querySelectorAll('[data-buy="full"]').forEach((control) => {
          const text = control.textContent || '';
          if (text.includes('Rakhi Gift Pack')) control.textContent = text.replace('Rakhi Gift Pack', 'Digital Rakhi Gift Pack');
          else if (text.includes('Add Gift Pack')) control.textContent = text.replace('Add Gift Pack', 'Add Digital Gift Pack');
        });

        document.querySelectorAll('[data-payment-zone]').forEach((zone) => {
          if (zone.querySelector('[data-minor-purchase-note]')) return;
          const note = document.createElement('p');
          note.className = 'checkout-note';
          note.setAttribute('data-minor-purchase-note', '');
          note.textContent = 'Under 18? A parent or legal guardian must make or authorise any paid purchase.';
          const status = zone.querySelector('[data-pay-status]');
          zone.insertBefore(note, status || null);
        });
      })();
    </script>
    <script>
      import '../scripts/multi-sibling';
    </script>
  </body>
</html>
