---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Support — Rakhi Battle by BondBop" noindex>
  <div class="shell legal contact-page">
    <p class="eyebrow">BondBop support</p>
    <h1>Tell us what went wrong.</h1>
    <p class="legal-lead">Rakhi Battle is a BondBop game operated in India by Divya Pandey. For payment or delivery help, include the battle code and payment reference—but never send a UPI PIN, OTP or full card number.</p>
    <p><strong>Email:</strong> <a href="mailto:support@bondbop.com">support@bondbop.com</a></p>
    <form class="card support-form" data-support-form>
      <label>Help with<select name="category" required><option value="technical">Technical problem</option><option value="payment">Payment</option><option value="delivery">Digital delivery</option><option value="privacy">Privacy</option><option value="other">Something else</option></select></label>
      <label>Your email<input type="email" name="email" autocomplete="email" maxlength="120" required placeholder="you@example.com" /></label>
      <label>Battle code or link <span>(optional)</span><input name="challenge" maxlength="200" placeholder="RB-ABC123 or result link" /></label>
      <label>What happened?<textarea name="message" minlength="20" maxlength="1500" required placeholder="Please include enough detail for us to investigate."></textarea></label>
      <button class="btn btn-primary" type="submit">Create support case</button>
      <p class="status" data-support-status aria-live="polite"></p>
    </form>
  </div>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-support-form]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault(); const button = form.querySelector<HTMLButtonElement>('button')!; const status = form.querySelector<HTMLElement>('[data-support-status]')!; button.disabled = true; status.textContent = 'Creating your case…';
    const values = Object.fromEntries(new FormData(form));
    const challengeText = String(values.challenge || '');
    const challengeId = challengeText.match(/[a-f0-9]{24}/i)?.[0]?.toLowerCase() || null;
    try {
      const response = await fetch('/api/support', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...values, challenge_id: challengeId, session_id: window.rakhiSession }) });
      const data = await response.json() as { case_id?: string; error?: string };
      if (!response.ok) throw new Error(data.error || 'Could not create the case.');
      form.reset(); status.textContent = `Case ${data.case_id} created. Please save this ID.`; window.rakhiTrack('support_submit', { category: values.category });
    } catch (error) { status.textContent = error instanceof Error ? error.message : 'Could not create the case.'; }
    finally { button.disabled = false; }
  });
</script>
