---
import Layout from '../layouts/Layout.astro';
import QuizGame from '../components/QuizGame.astro';
import { db } from '../lib/server';
import '../styles/lobby-extras.css';

const [battleStats, activeStats, hallStats] = await db().batch([
  db().prepare(`SELECT COUNT(*) AS completed,
                       (SELECT COUNT(*) FROM (
                          SELECT root_challenge_id
                            FROM challenges
                           WHERE status = 'complete' AND expires_at > CURRENT_TIMESTAMP
                           GROUP BY root_challenge_id HAVING COUNT(*) > 1
                        )) AS family_chains
                  FROM challenges
                 WHERE status = 'complete' AND expires_at > CURRENT_TIMESTAMP`),
  db().prepare(`SELECT COUNT(DISTINCT session_id) AS active
                  FROM events
                 WHERE created_at >= datetime('now', '-10 minutes')
                   AND event_name IN ('battle_start', 'challenge_open', 'challenge_complete')`),
  db().prepare(`SELECT MAX(score) AS top_score
                  FROM challenges
                 WHERE status = 'complete'
                   AND leaderboard_creator_opt_in = 1
                   AND leaderboard_sibling_opt_in = 1
                   AND expires_at > CURRENT_TIMESTAMP`),
]);
const completedBattles = Number((battleStats.results[0] as { completed?: number } | undefined)?.completed || 0);
const familyChains = Number((battleStats.results[0] as { family_chains?: number } | undefined)?.family_chains || 0);
const activePlayers = Number((activeStats.results[0] as { active?: number } | undefined)?.active || 0);
const topHallScore = Number((hallStats.results[0] as { top_score?: number } | undefined)?.top_score || 0);
---
<Layout gameMode>
  <div class="game-app-shell" data-game-app>
    <nav class="game-hud" aria-label="Game controls">
      <a class="game-brand" href="/" aria-label="Rakhi Battle home"><span>र</span><b>RAKHI BATTLE</b></a>
      <div><a href="/leaderboard">🏵️ Hall</a><span class="game-date">28 AUG</span></div>
    </nav>

    <section class="game-lobby" data-game-lobby aria-label="Rakhi Battle opening screen">
      <div class="lobby-cinema" aria-hidden="true">
        <img src="/images/rakhi-celebration.webp" width="1536" height="1024" alt="" fetchpriority="high" />
        <span class="cinema-glow cinema-glow-one"></span><span class="cinema-glow cinema-glow-two"></span>
        <i class="cinema-spark spark-one">✦</i><i class="cinema-spark spark-two">✦</i><i class="cinema-spark spark-three">✦</i>
      </div>
      <div class="lobby-shade"></div>
      <div class="lobby-content">
        <p class="game-kicker">🪔 Raksha Bandhan 2026 • 8 memories</p>
        <div class="rakhi-countdown" data-rakhi-countdown role="timer" aria-label="Countdown to Raksha Bandhan 2026">
          <span class="rakhi-countdown-label" data-rakhi-countdown-label>RAKHI DAY IN</span>
          <span class="rakhi-countdown-digits" data-rakhi-countdown-digits>
            <b data-rakhi-days>--</b><i>D</i><em>:</em><b data-rakhi-hours>--</b><i>H</i><em>:</em><b data-rakhi-minutes>--</b><i>M</i><em>:</em><b data-rakhi-seconds>--</b><i>S</i>
          </span>
        </div>
        <h1>Har Rakhi ke dhaage mein <span>ek poora bachpan bandha hota hai.</span></h1>
        <p class="lobby-line">Ek hi bachpan. Do alag kahaaniyan.</p>
        <p class="lobby-copy">Mummy ki daant, remote ki ladai aur mithai ki chori—dekho tum dono ko kya yaad hai.</p>
        <a class="game-cta" href="/play" data-enter-game><span>Apni Rakhi Battle shuru karo</span><b>PLAY →</b></a>
        <div class="game-proof"><span>⚡ 60 sec</span><span>🎨 Free result card</span><span>🔒 No signup</span></div>
        <a class="lobby-info-link" href="/info">ⓘ Info &amp; Policies</a>
        {(completedBattles > 0 || activePlayers > 0 || topHallScore > 0) && <div class="live-game-proof" aria-label="Live Rakhi Battle activity">
          {completedBattles > 0 && <span><i></i><b>{completedBattles.toLocaleString('en-IN')}</b> stories compared</span>}
          {activePlayers > 0 && <span><b>{activePlayers}</b> active in 10 min</span>}
          {familyChains > 1 && <span><b>{familyChains}</b> family chains</span>}
          {topHallScore > 0 && <a href="/leaderboard">Hall best <b>{topHallScore}%</b> →</a>}
        </div>}
      </div>

      <section class="game-resume hidden" data-recent-battles>
        <div><p class="eyebrow">🧵 Recent battle</p><div class="recent-list" data-recent-list aria-live="polite"></div></div>
      </section>
    </section>

    <section class="game-play-scene hidden" data-game-play>
      <button class="game-back" type="button" data-exit-game aria-label="Back to opening">←</button>
      <QuizGame role="creator" />
    </section>
  </div>
</Layout>
<script>
  import { forgetBattle, readRecentBattles, type RecentBattle } from '../lib/recent';

  window.rakhiTrack('landing_view');

  const app = document.querySelector<HTMLElement>('[data-game-app]');
  const lobby = document.querySelector<HTMLElement>('[data-game-lobby]');
  const play = document.querySelector<HTMLElement>('[data-game-play]');
  document.querySelector<HTMLAnchorElement>('[data-enter-game]')?.addEventListener('click', (event) => {
    event.preventDefault();
    lobby?.classList.add('lobby-exit');
    setTimeout(() => {
      lobby?.classList.add('hidden');
      play?.classList.remove('hidden');
      app?.classList.add('is-playing');
      document.querySelector<HTMLInputElement>('[data-name]')?.focus({ preventScroll: true });
    }, 430);
  });
  document.querySelector('[data-exit-game]')?.addEventListener('click', () => {
    if (document.querySelector('[data-quiz]')?.classList.contains('quiz-active')) return;
    play?.classList.add('hidden');
    lobby?.classList.remove('hidden', 'lobby-exit');
    app?.classList.remove('is-playing');
  });

  const countdown = document.querySelector<HTMLElement>('[data-rakhi-countdown]');
  const countdownLabel = countdown?.querySelector<HTMLElement>('[data-rakhi-countdown-label]');
  const countdownDigits = countdown?.querySelector<HTMLElement>('[data-rakhi-countdown-digits]');
  const daysNode = countdown?.querySelector<HTMLElement>('[data-rakhi-days]');
  const hoursNode = countdown?.querySelector<HTMLElement>('[data-rakhi-hours]');
  const minutesNode = countdown?.querySelector<HTMLElement>('[data-rakhi-minutes]');
  const secondsNode = countdown?.querySelector<HTMLElement>('[data-rakhi-seconds]');
  const rakhiStart = Date.parse('2026-08-28T00:00:00+05:30');
  const rakhiEnd = Date.parse('2026-08-29T00:00:00+05:30');
  let countdownTimer: number | undefined;

  function updateRakhiCountdown() {
    if (!countdown || !countdownLabel || !countdownDigits) return;
    const now = Date.now();
    if (now >= rakhiStart) {
      if (countdownTimer) window.clearInterval(countdownTimer);
      countdown.classList.add('is-live');
      countdownLabel.textContent = now < rakhiEnd ? 'RAKHI DAY' : 'RAKHI 2026';
      countdownDigits.innerHTML = now < rakhiEnd
        ? '<strong class="rakhi-live">IT\'S ON • PLAY NOW 🔥</strong>'
        : '<strong class="rakhi-live">KEEP THE BATTLE GOING ✦</strong>';
      return;
    }
    const remaining = rakhiStart - now;
    const days = Math.floor(remaining / 86400000);
    const hours = Math.floor((remaining % 86400000) / 3600000);
    const minutes = Math.floor((remaining % 3600000) / 60000);
    const seconds = Math.floor((remaining % 60000) / 1000);
    if (daysNode) daysNode.textContent = String(days).padStart(2, '0');
    if (hoursNode) hoursNode.textContent = String(hours).padStart(2, '0');
    if (minutesNode) minutesNode.textContent = String(minutes).padStart(2, '0');
    if (secondsNode) secondsNode.textContent = String(seconds).padStart(2, '0');
  }

  updateRakhiCountdown();
  countdownTimer = window.setInterval(updateRakhiCountdown, 1000);

  const recentSection = document.querySelector<HTMLElement>('[data-recent-battles]');
  const recentList = document.querySelector<HTMLElement>('[data-recent-list]');

  interface BattleStatus {
    id: string;
    creator_name: string;
    sibling_name: string | null;
    score: number | null;
    status: 'open' | 'complete';
    completed: boolean;
    sibling_progress: number;
  }

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }

  async function loadStatus(item: RecentBattle): Promise<{ item: RecentBattle; status: BattleStatus } | null> {
    try {
      const response = await fetch(`/api/challenges/${item.id}`);
      if (!response.ok) {
        if (response.status === 404) forgetBattle(item.id);
        return null;
      }
      return { item, status: await response.json() as BattleStatus };
    } catch {
      return null;
    }
  }

  async function shareAgain(id: string, button: HTMLButtonElement) {
    const url = `${location.origin}/battle/${id}?ref=recent_battle`;
    if (navigator.share) {
      await navigator.share({ title: 'Rakhi Battle 2026', text: '🪔 Your Rakhi challenge is waiting!', url });
    } else {
      await navigator.clipboard.writeText(url);
      button.textContent = 'Link copied ✓';
    }
  }

  function renderRow(item: RecentBattle, status: BattleStatus) {
    const row = element('article', 'recent-item');
    const icon = element('span', 'recent-icon');
    icon.textContent = status.completed ? '🏆' : item.role === 'creator' ? '💌' : '⚡';

    const detail = element('div', 'recent-detail');
    const title = element('strong');
    title.textContent = status.sibling_name ? `${status.creator_name} × ${status.sibling_name}` : status.creator_name;
    const meta = element('small');
    meta.textContent = status.completed
      ? `${status.score}% match • result ready`
      : item.role === 'creator'
        ? status.sibling_progress ? `${status.sibling_progress}/8 answers received` : 'Waiting for your sibling'
        : 'Challenge in progress';
    detail.appendChild(title);
    detail.appendChild(meta);

    const actions = element('div', 'recent-actions');
    if (status.completed) {
      const open = element('a', 'btn btn-primary btn-small');
      open.href = `/result/${item.id}`;
      open.textContent = 'View result';
      actions.appendChild(open);
    } else if (item.role === 'creator') {
      const wait = element('a', 'btn btn-gold btn-small');
      wait.href = `/waiting/${item.id}`;
      wait.textContent = 'Waiting room';
      actions.appendChild(wait);
      const share = element('button', 'btn btn-primary btn-small');
      share.type = 'button';
      share.textContent = 'Share again';
      share.addEventListener('click', () => shareAgain(item.id, share).catch(() => { share.textContent = 'Copy failed'; }));
      actions.appendChild(share);
    } else {
      const open = element('a', 'btn btn-primary btn-small');
      open.href = `/battle/${item.id}`;
      open.textContent = 'Continue';
      actions.appendChild(open);
    }

    const remove = element('button', 'recent-remove');
    remove.type = 'button';
    remove.setAttribute('aria-label', `Remove ${status.creator_name} battle from this device`);
    remove.textContent = '×';
    remove.addEventListener('click', () => {
      forgetBattle(item.id);
      row.remove();
      if (!recentList?.children.length) recentSection?.classList.add('hidden');
    });
    actions.appendChild(remove);
    row.appendChild(icon);
    row.appendChild(detail);
    row.appendChild(actions);
    recentList?.appendChild(row);
  }

  const recent = readRecentBattles().slice(0, 1);
  if (recent.length && recentSection && recentList) {
    Promise.all(recent.map(loadStatus)).then((rows) => {
      rows.filter((row): row is NonNullable<typeof row> => Boolean(row)).forEach(({ item, status }) => renderRow(item, status));
      if (recentList.children.length) recentSection.classList.remove('hidden');
    });
  }
</script>
