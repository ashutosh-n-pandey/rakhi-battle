---
import Layout from '../layouts/Layout.astro';
import QuizGame from '../components/QuizGame.astro';
---
<Layout>
  <div class="shell wide-shell">
    <section class="festival-strip" aria-label="Raksha Bandhan celebration">
      <span>शुभ रक्षाबंधन</span><i>✦</i><span>28 August 2026</span><i>✦</i><span>Ek dhaaga • poora bachpan</span>
    </section>

    <section class="hero festive-hero">
      <div class="hero-content">
        <p class="eyebrow">🪔 Free Rakhi game • 8 memories • no signup</p>
        <h1>Har Rakhi ke dhaage mein <span>ek poora bachpan bandha hota hai.</span></h1>
        <p class="hero-kicker">Ek hi bachpan. Do alag kahaaniyan.</p>
        <p class="hero-copy">8 sawaalon mein kholo woh yaadein jo sirf tum dono samajhte ho—mummy ki daant, remote ki ladai, chhupayi hui mithai aur har baar ke naye excuses.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#play">Apni Rakhi Battle shuru karo</a>
          <a class="btn btn-ghost" href="/leaderboard">See Hall of Fame</a>
        </div>
        <div class="proof-row"><span>⚡ 60–90 seconds</span><span>📲 WhatsApp-ready</span><span>🎨 Free festive poster</span></div>
      </div>
      <figure class="hero-art">
        <img src="/images/rakhi-celebration.webp" width="1536" height="1024" alt="A sister tying a rakhi on her brother during a joyful Raksha Bandhan celebration" fetchpriority="high" />
        <figcaption><span>✨</span> One thread. Eight memories. Unlimited teasing.</figcaption>
      </figure>
    </section>

    <section class="recent-battles hidden" data-recent-battles>
      <div class="recent-heading">
        <div><p class="eyebrow">🧵 Your recent Rakhi battles</p><h2>Pick up where you left off.</h2></div>
        <a class="btn btn-gold" href="#play">+ Start new</a>
      </div>
      <p class="recent-note">Saved only in this browser. No account or login.</p>
      <div class="recent-list" data-recent-list aria-live="polite"></div>
    </section>

    <section id="how" class="how festival-how">
      <p class="eyebrow">The Rakhi ritual, remixed</p>
      <h2>From tilak to childhood throwback.</h2>
      <p class="section-copy">No app download and no account. Just nicknames, a private challenge link and the two versions of your shared childhood.</p>
      <div class="steps">
        <article class="step"><span class="step-icon">🪔</span><b>01 — Apni kahaani</b><span>Answer 8 playful questions from your shared bachpan.</span></article>
        <article class="step"><span class="step-icon">💌</span><b>02 — Sibling ki kahaani</b><span>Send one private WhatsApp challenge; no signup needed.</span></article>
        <article class="step"><span class="step-icon">🏆</span><b>03 — Dono ka verdict</b><span>Reveal the score, festive poster and Family Court.</span></article>
      </div>
    </section>

    <section class="hall-invite">
      <div><p class="eyebrow">🏵️ New: Rakhi Hall of Fame</p><h2>Same names. Still unique.</h2></div>
      <p>Every battle gets a private random identity and a short public code. A result reaches the leaderboard only when <strong>both siblings</strong> say yes.</p>
      <a class="text-link" href="/leaderboard">Visit the Hall of Fame →</a>
    </section>

    <section id="play" class="how play-section">
      <div class="play-heading"><p class="eyebrow">Your turn, ji</p><h2>Memory box kholo.</h2><p>Nickname ready? Mithai 60 seconds wait kar sakti hai.</p></div>
      <QuizGame role="creator" />
    </section>
  </div>
</Layout>
<script>
  import { forgetBattle, readRecentBattles, type RecentBattle } from '../lib/recent';

  window.rakhiTrack('landing_view');

  const recentSection = document.querySelector<HTMLElement>('[data-recent-battles]');
  const recentList = document.querySelector<HTMLElement>('[data-recent-list]');

  interface BattleStatus {
    id: string;
    creator_name: string;
    sibling_name: string | null;
    score: number | null;
    status: 'open' | 'complete';
    completed: boolean;
    sibling_progress: number;
  }

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }

  async function loadStatus(item: RecentBattle): Promise<{ item: RecentBattle; status: BattleStatus } | null> {
    try {
      const response = await fetch(`/api/challenges/${item.id}`);
      if (!response.ok) {
        if (response.status === 404) forgetBattle(item.id);
        return null;
      }
      return { item, status: await response.json() as BattleStatus };
    } catch {
      return null;
    }
  }

  async function shareAgain(id: string, button: HTMLButtonElement) {
    const url = `${location.origin}/battle/${id}?ref=recent_battle`;
    if (navigator.share) {
      await navigator.share({ title: 'Rakhi Battle 2026', text: '🪔 Your Rakhi challenge is waiting!', url });
    } else {
      await navigator.clipboard.writeText(url);
      button.textContent = 'Link copied ✓';
    }
  }

  function renderRow(item: RecentBattle, status: BattleStatus) {
    const row = element('article', 'recent-item');
    const icon = element('span', 'recent-icon');
    icon.textContent = status.completed ? '🏆' : item.role === 'creator' ? '💌' : '⚡';

    const detail = element('div', 'recent-detail');
    const title = element('strong');
    title.textContent = status.sibling_name ? `${status.creator_name} × ${status.sibling_name}` : status.creator_name;
    const meta = element('small');
    meta.textContent = status.completed
      ? `${status.score}% match • result ready`
      : item.role === 'creator'
        ? status.sibling_progress ? `${status.sibling_progress}/8 answers received` : 'Waiting for your sibling'
        : 'Challenge in progress';
    detail.appendChild(title);
    detail.appendChild(meta);

    const actions = element('div', 'recent-actions');
    if (status.completed) {
      const open = element('a', 'btn btn-primary btn-small');
      open.href = `/result/${item.id}`;
      open.textContent = 'View result';
      actions.appendChild(open);
    } else if (item.role === 'creator') {
      const wait = element('a', 'btn btn-gold btn-small');
      wait.href = `/waiting/${item.id}`;
      wait.textContent = 'Waiting room';
      actions.appendChild(wait);
      const share = element('button', 'btn btn-primary btn-small');
      share.type = 'button';
      share.textContent = 'Share again';
      share.addEventListener('click', () => shareAgain(item.id, share).catch(() => { share.textContent = 'Copy failed'; }));
      actions.appendChild(share);
    } else {
      const open = element('a', 'btn btn-primary btn-small');
      open.href = `/battle/${item.id}`;
      open.textContent = 'Continue';
      actions.appendChild(open);
    }

    const remove = element('button', 'recent-remove');
    remove.type = 'button';
    remove.setAttribute('aria-label', `Remove ${status.creator_name} battle from this device`);
    remove.textContent = '×';
    remove.addEventListener('click', () => {
      forgetBattle(item.id);
      row.remove();
      if (!recentList?.children.length) recentSection?.classList.add('hidden');
    });
    actions.appendChild(remove);
    row.appendChild(icon);
    row.appendChild(detail);
    row.appendChild(actions);
    recentList?.appendChild(row);
  }

  const recent = readRecentBattles();
  if (recent.length && recentSection && recentList) {
    Promise.all(recent.map(loadStatus)).then((rows) => {
      rows.filter((row): row is NonNullable<typeof row> => Boolean(row)).forEach(({ item, status }) => renderRow(item, status));
      if (recentList.children.length) recentSection.classList.remove('hidden');
    });
  }
</script>
