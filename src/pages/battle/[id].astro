---
import Layout from '../../layouts/Layout.astro';
import QuizGame from '../../components/QuizGame.astro';
import { getChallenge } from '../../lib/server';

const id = Astro.params.id ?? '';
const challenge = await getChallenge(id);
if (!challenge) return Astro.redirect('/?invalid=1');
if (challenge.status === 'complete') return Astro.redirect(`/result/${id}`);
const title = `${challenge.creator_name} challenged you — Rakhi Battle 2026`;
const description = `${challenge.creator_name} remembers your childhood differently. Open the same eight memories and compare your Rakhi stories.`;
---
<Layout title={title} description={description} noindex>
  <div class="shell">
    <section class="hero" style="padding-top: 24px">
      <p class="eyebrow">🪔 A Rakhi memory has arrived</p>
      <h1><span>{challenge.creator_name}</span> remembers your bachpan differently.</h1>
      <p class="hero-copy">8 sawaal. Do kahaaniyan. One festive sibling score.</p>
    </section>
    <QuizGame
      role="sibling"
      challengeId={id}
      creatorName={challenge.creator_name}
      leaderboardCreatorOptIn={challenge.leaderboard_creator_opt_in === 1}
    />
  </div>
</Layout>
